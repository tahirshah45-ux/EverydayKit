# EverydayKit Environment Configuration Example
# Copy to .env.local for local configuration. Never commit secrets or live credentials.

# Public base URL where EverydayKit is hosted (used for canonical URLs & sitemap replacement)
APP_URL="https://everydaykit.app"

# ---------------------------------------------------------------------------
# Optional Isolated Ad-Provider Configuration (DISABLED by default)
# ---------------------------------------------------------------------------
# Leave these blank to keep all ad placements disabled (recommended until you
# have a verified ad account, privacy/consent flow, and approved CSP rules).
#
# Supported verified values for VITE_AD_PROVIDER: "adsense" | "gam"
VITE_AD_PROVIDER=""
VITE_AD_CLIENT_ID=""

# Placement-specific ad unit / slot IDs (leave blank to keep a placement off):
VITE_AD_SLOT_HOME_HERO=""
VITE_AD_SLOT_DIRECTORY=""
VITE_AD_SLOT_TOOL_SIDEBAR=""
VITE_AD_SLOT_TOOL_RESULT=""
