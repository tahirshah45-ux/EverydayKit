<script>
    (function initCalculatorEngine() {
      const baseInput = document.getElementById('base-price');
      const discountInput = document.getElementById('discount-input');
      const discountSlider = document.getElementById('discount-slider');
      const discountMinus = document.getElementById('discount-minus');
      const discountPlus = document.getElementById('discount-plus');
      const toggleMember = document.getElementById('toggle-member');
      const toggleTax = document.getElementById('toggle-tax');
      const clearBtn = document.getElementById('clear-price-btn');
      const copyBtn = document.getElementById('copy-summary-btn');
      const resetBtn = document.getElementById('reset-workspace-btn');
      const presetChips = document.querySelectorAll('.preset-chip');

      // Outputs
      const outputFinalPrice = document.getElementById('output-final-price');
      const outputStrikethrough = document.getElementById('output-strikethrough');
      const outputSavingsTotal = document.getElementById('output-savings-total');
      const savingsPillPct = document.getElementById('savings-pill-pct');
      const metricSavings = document.getElementById('metric-savings');
      const metricEffectivePct = document.getElementById('metric-effective-pct');
      const metricShelf = document.getElementById('metric-shelf');
      const metricTax = document.getElementById('metric-tax');
      const metricCoupon = document.getElementById('metric-coupon');
      const discountBadge = document.getElementById('discount-badge');
      const formulaFinalVal = document.getElementById('formula-final-val');

      // Formula breakdown items
      const stepCouponRow = document.getElementById('step-coupon-row');
      const stepCouponVal = document.getElementById('step-coupon-val');
      const stepTaxRow = document.getElementById('step-tax-row');
      const stepTaxVal = document.getElementById('step-tax-val');

      function formatMoney(num) {
        return '$' + Math.max(0, num).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      function compute() {
        const base = parseFloat(baseInput.value) || 0;
        const discountRate = Math.min(100, Math.max(0, parseFloat(discountInput.value) || 0));

        // 1. Initial discount
        const initialDiscountAmount = (base * discountRate) / 100;
        let runningTotal = base - initialDiscountAmount;

        // 2. Member coupon (10% compound)
        let couponDiscountAmount = 0;
        if (toggleMember && toggleMember.checked) {
          couponDiscountAmount = runningTotal * 0.10;
          runningTotal -= couponDiscountAmount;
          if (stepCouponRow) {
            stepCouponRow.classList.remove('hidden');
            stepCouponVal.textContent = '-' + formatMoney(couponDiscountAmount);
          }
        } else if (stepCouponRow) {
          stepCouponRow.classList.add('hidden');
        }

        // 3. Tax (8.25% municipal)
        let taxAmount = 0;
        if (toggleTax && toggleTax.checked) {
          taxAmount = runningTotal * 0.0825;
          runningTotal += taxAmount;
          if (stepTaxRow) {
            stepTaxRow.classList.remove('hidden');
            stepTaxVal.textContent = '+' + formatMoney(taxAmount);
          }
        } else if (stepTaxRow) {
          stepTaxRow.classList.add('hidden');
        }

        const totalSaved = Math.max(0, (initialDiscountAmount + couponDiscountAmount));
        const effectivePct = base > 0 ? ((base - (runningTotal - taxAmount)) / base) * 100 : discountRate;

        // Update main views
        if (outputFinalPrice) outputFinalPrice.textContent = formatMoney(runningTotal);
        if (outputStrikethrough) outputStrikethrough.textContent = formatMoney(base);
        if (outputSavingsTotal) outputSavingsTotal.textContent = formatMoney(totalSaved);
        if (savingsPillPct) savingsPillPct.textContent = '-' + effectivePct.toFixed(2) + '%';
        if (discountBadge) discountBadge.textContent = discountRate.toFixed(0) + '% OFF';

        // Secondary metrics
        if (metricSavings) metricSavings.textContent = formatMoney(totalSaved);
        if (metricEffectivePct) metricEffectivePct.textContent = effectivePct.toFixed(1) + '%';
        if (metricShelf) metricShelf.textContent = formatMoney(base);
        if (metricTax) metricTax.textContent = formatMoney(taxAmount);
