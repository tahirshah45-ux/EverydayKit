    const toolCards = document.querySelectorAll('.tool-card');
    const countDisplay = document.getElementById('tools-count');
    const demoDropzone = document.getElementById('demo-dropzone');
    const demoFileInput = document.getElementById('demo-file-input');
    const dropzoneStatus = document.getElementById('dropzone-status');

    let currentFilter = 'all';

    function updateVisibility() {
      const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
      let visibleCount = 0;

      toolCards.forEach(card => {
        const category = card.getAttribute('data-category');
        const textContent = card.innerText.toLowerCase();

        const matchesFilter = (currentFilter === 'all') || (category === currentFilter);
        const matchesQuery = query === '' || textContent.includes(query);

        if (matchesFilter && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countDisplay) {
        countDisplay.textContent = visibleCount + (visibleCount === 1 ? ' tool ready' : ' tools ready');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', updateVisibility);
    }

    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        filterChips.forEach(c => {
          c.classList.remove('bg-primary', 'text-on-primary', 'active');
          c.classList.add('bg-surface-container-highest', 'text-on-surface');
        });
        chip.classList.add('bg-primary', 'text-on-primary', 'active');
        chip.classList.remove('bg-surface-container-highest', 'text-on-surface');

        currentFilter = chip.getAttribute('data-filter') || 'all';
        updateVisibility();
      });
    });

    if (demoFileInput && dropzoneStatus) {
      demoFileInput.addEventListener('change', (e) => {
        const files = e.target.files;
        if (files && files.length > 0) {
          const totalSizeMb = Array.from(files).reduce((acc, f) => acc + f.size, 0) / (1024 * 1024);
          dropzoneStatus.textContent = files.length + (files.length === 1 ? ' file loaded (' : ' files loaded (') + totalSizeMb.toFixed(2) + ' MB) · Local Memory';
          dropzoneStatus.classList.remove('bg-surface-container', 'text-secondary');
          dropzoneStatus.classList.add('bg-tertiary-fixed', 'text-on-tertiary-fixed');
        }
      });
    }

    if (demoDropzone) {
      demoDropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        demoDropzone.classList.add('bg-surface-container-high');
      });
      demoDropzone.addEventListener('dragleave', () => {
        demoDropzone.classList.remove('bg-surface-container-high');
      });
      demoDropzone.addEventListener('drop', () => {
        demoDropzone.classList.remove('bg-surface-container-high');
      });
    }
  })();
