<script>
  function setScreenState(state) {
    const emptyView = document.getElementById('view-empty');
    const queueView = document.getElementById('view-queue');
    const controlsView = document.getElementById('view-controls');
    const processingView = document.getElementById('view-processing');
    const successView = document.getElementById('view-success');

    // Button states
    ['empty', 'active', 'processing', 'success'].forEach(s => {
      const btn = document.getElementById(`btn-state-${s}`);
      if (!btn) return;
      if (s === state) {
        btn.className = 'px-2.5 py-1 text-label-sm font-label-sm rounded-md transition-all bg-surface-container-lowest text-primary shadow-sm font-semibold';
      } else {
        btn.className = 'px-2.5 py-1 text-label-sm font-label-sm rounded-md transition-all text-secondary hover:text-on-surface';
      }
    });

    // Toggle views
    if (state === 'empty') {
      emptyView.classList.remove('hidden');
      emptyView.classList.add('flex');
      queueView.classList.add('hidden');
      controlsView.classList.add('hidden');
      processingView.classList.add('hidden');
      successView.classList.add('hidden');
    } else if (state === 'active') {
      emptyView.classList.add('hidden');
