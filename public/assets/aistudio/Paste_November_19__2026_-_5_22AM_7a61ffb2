      states.forEach(st => {
        const el = document.getElementById('state-' + st);
        const tab = document.getElementById('tab-' + st);
        if (el) el.classList.add('hidden');
        if (tab) {
          tab.classList.remove('bg-primary', 'text-on-primary', 'font-semibold', 'shadow-xs');
          tab.classList.add('text-on-surface-variant');
        }
      });

      const activeEl = document.getElementById('state-' + stateName);
      const activeTab = document.getElementById('tab-' + stateName);
