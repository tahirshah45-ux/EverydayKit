<script>
  (function initCalculator() {
    const basePriceInput = document.getElementById('basePriceInput');
    const discountRateInput = document.getElementById('discountRateInput');
    const discountSlider = document.getElementById('discountSlider');
    const discountBadge = document.getElementById('discountBadge');
    const clearPriceBtn = document.getElementById('clearPriceBtn');
    const presetPills = document.querySelectorAll('.preset-pill');
    
    const couponToggle = document.getElementById('couponToggle');
    const couponKnob = document.getElementById('couponKnob');
    const taxToggle = document.getElementById('taxToggle');
    const taxKnob = document.getElementById('taxKnob');
    
    const finalPriceDisplay = document.getElementById('finalPriceDisplay');
    const strikethroughPrice = document.getElementById('strikethroughPrice');
    const totalSavingsReadout = document.getElementById('totalSavingsReadout');
    const rawSavedAmount = document.getElementById('rawSavedAmount');
    const taxAmountMetric = document.getElementById('taxAmountMetric');
    const savingsBadge = document.getElementById('savingsBadge');
    
    const formulaBase = document.getElementById('formulaBase');
    const formulaDiscount = document.getElementById('formulaDiscount');
    const formulaCoupon = document.getElementById('formulaCoupon');
    const formulaStackRow = document.getElementById('formulaStackRow');
    const formulaNetDeduction = document.getElementById('formulaNetDeduction');
    
    const copyPriceBtn = document.getElementById('copyPriceBtn');
    const copyBreakdownBtn = document.getElementById('copyBreakdownBtn');
    const resetFormBtn = document.getElementById('resetFormBtn');

    let hasCoupon = false;
    let hasTax = false;
    const TAX_RATE = 0.0825;
    const COUPON_RATE = 0.10;

    function recalculate() {
      let base = parseFloat(basePriceInput.value) || 0;
      let discount = parseFloat(discountRateInput.value) || 0;

      if (discount > 100) discount = 100;
      if (discount < 0) discount = 0;

      // Base discount savings
      const primarySavings = base * (discount / 100);
      let runningPrice = base - primarySavings;
      let couponSavings = 0;

      if (hasCoupon) {
        couponSavings = runningPrice * COUPON_RATE;
        runningPrice -= couponSavings;
        formulaStackRow.style.display = 'flex';
        formulaCoupon.innerText = `+$${couponSavings.toFixed(2)} (10% on subtotal)`;
      } else {
        formulaStackRow.style.display = 'none';
      }

      let taxTotal = 0;
      if (hasTax) {
        taxTotal = runningPrice * TAX_RATE;
        runningPrice += taxTotal;
      }

      const totalSaved = primarySavings + couponSavings;
      const effectiveDiscountPercent = base > 0 ? ((base - (runningPrice - taxTotal)) / base) * 100 : 0;

      // Update Displays
      finalPriceDisplay.innerText = runningPrice.toFixed(2);
      strikethroughPrice.innerText = `$${base.toFixed(2)}`;
      totalSavingsReadout.innerText = `Total Savings: $${totalSaved.toFixed(2)}`;
      rawSavedAmount.innerText = `$${totalSaved.toFixed(2)}`;
      taxAmountMetric.innerText = `$${taxTotal.toFixed(2)}`;
      discountBadge.innerText = `${Math.round(discount)}% OFF`;
      savingsBadge.innerHTML = `<span class="material-symbols-outlined text-[14px]">trending_down</span> -${effectiveDiscountPercent.toFixed(2)}%`;

      // Update Formulas
      formulaBase.innerText = `$${base.toFixed(2)}`;
      formulaDiscount.innerHTML = `${base.toFixed(2)} &times; ${(discount / 100).toFixed(2)} = $${primarySavings.toFixed(2)}`;
      formulaNetDeduction.innerText = `${base.toFixed(2)} - ${totalSaved.toFixed(2)} = $${(base - totalSaved).toFixed(2)}`;
    }

    // Sync Slider and Numeric Discount Input
    discountSlider.addEventListener('input', (e) => {
      discountRateInput.value = e.target.value;
      recalculate();
    });

    discountRateInput.addEventListener('input', (e) => {
      let val = Math.min(100, Math.max(0, parseFloat(e.target.value) || 0));
      discountSlider.value = val;
      recalculate();
    });

    basePriceInput.addEventListener('input', recalculate);

    clearPriceBtn.addEventListener('click', () => {
      basePriceInput.value = '';
      basePriceInput.focus();
      recalculate();
    });

    document.getElementById('incrementDiscount').addEventListener('click', () => {
      let current = parseInt(discountRateInput.value, 10) || 0;
      if (current < 100) {
        discountRateInput.value = current + 1;
        discountSlider.value = current + 1;
        recalculate();
      }
    });

    document.getElementById('decrementDiscount').addEventListener('click', () => {
      let current = parseInt(discountRateInput.value, 10) || 0;
      if (current > 0) {
        discountRateInput.value = current - 1;
        discountSlider.value = current - 1;
        recalculate();
      }
    });

    // Preset Pill Buttons
    presetPills.forEach(pill => {
      pill.addEventListener('click', () => {
        presetPills.forEach(p => {
          p.classList.remove('bg-primary-container', 'text-on-primary');
          p.classList.add('bg-surface-container-low', 'text-on-surface');
        });
        pill.classList.remove('bg-surface-container-low', 'text-on-surface');
        pill.classList.add('bg-primary-container', 'text-on-primary');

        const rate = parseInt(pill.innerText, 10);
        discountRateInput.value = rate;
        discountSlider.value = rate;
        recalculate();
      });
    });

    // Coupon Toggle Switch
    couponToggle.addEventListener('click', () => {
      hasCoupon = !hasCoupon;
      couponToggle.setAttribute('aria-checked', hasCoupon.toString());
      if (hasCoupon) {
        couponToggle.classList.remove('bg-surface-container-high');
        couponToggle.classList.add('bg-primary');
        couponKnob.classList.add('translate-x-5');
      } else {
        couponToggle.classList.add('bg-surface-container-high');
        couponToggle.classList.remove('bg-primary');
        couponKnob.classList.remove('translate-x-5');
      }
      recalculate();
    });

    // Tax Toggle Switch
    taxToggle.addEventListener('click', () => {
      hasTax = !hasTax;
      taxToggle.setAttribute('aria-checked', hasTax.toString());
      if (hasTax) {
        taxToggle.classList.remove('bg-surface-container-high');
        taxToggle.classList.add('bg-primary');
        taxKnob.classList.add('translate-x-5');
      } else {
        taxToggle.classList.add('bg-surface-container-high');
        taxToggle.classList.remove('bg-primary');
        taxKnob.classList.remove('translate-x-5');
      }
      recalculate();
    });

    // Reset Form
    resetFormBtn.addEventListener('click', () => {
      basePriceInput.value = '149.99';
      discountRateInput.value = '35';
      discountSlider.value = '35';
      hasCoupon = false;
      hasTax = false;
      couponKnob.classList.remove('translate-x-5');
      couponToggle.classList.add('bg-surface-container-high');
      couponToggle.classList.remove('bg-primary');
      taxKnob.classList.remove('translate-x-5');
      taxToggle.classList.add('bg-surface-container-high');
      taxToggle.classList.remove('bg-primary');
      recalculate();
    });

    // Clipboard Copy Buttons
    copyPriceBtn.addEventListener('click', () => {
      const price = `$${finalPriceDisplay.innerText}`;
      navigator.clipboard.writeText(price).then(() => {
        const originalText = copyPriceBtn.innerHTML;
        copyPriceBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">done</span> Copied!';
        setTimeout(() => copyPriceBtn.innerHTML = originalText, 1500);
      });
    });

    copyBreakdownBtn.addEventListener('click', () => {
      const breakdown = `Original: $${basePriceInput.value}\nDiscount: ${discountRateInput.value}%\nSavings: ${rawSavedAmount.innerText}\nFinal Price: $${finalPriceDisplay.innerText}`;
      navigator.clipboard.writeText(breakdown).then(() => {
        const originalText = copyBreakdownBtn.innerHTML;
        copyBreakdownBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">done</span> Copied!';
        setTimeout(() => copyBreakdownBtn.innerHTML = originalText, 1500);
      });
    });

    // Initial render
    recalculate();
  })();
</script></main></body></html>

